# Copy this file to .env.local (git-ignored) and fill in real values as needed.
# Nothing here is required to run the app locally — without these, the frontend falls back to a
# local development sign-in bypass (mirrors the backend's DevBypassAuthHandler) and calls the API
# through the Vite dev proxy at /api.

# --- API base URL ---
# Leave unset to use the Vite dev proxy (/api -> http://localhost:5006, see vite.config.ts).
# Set this when the frontend is served separately from the backend (e.g. a deployed environment).
# VITE_API_BASE_URL=https://your-backend-host/api

# --- Microsoft Entra ID (Azure AD) — for real "Continue with Microsoft" sign-in ---
# Leave all three unset to use the local dev-bypass login instead of real MSAL.
# VITE_AAD_CLIENT_ID=<SPA app registration client ID>
# VITE_AAD_TENANT_ID=<your Entra ID tenant ID>
# VITE_AAD_API_SCOPE=api://<API app registration client ID>/access_as_user
