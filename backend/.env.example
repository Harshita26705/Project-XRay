# X-Ray runtime mode: demo | live
XRAY_MODE=demo

# AI reasoning backend: mock | foundry | openai_compatible
XRAY_AI_BACKEND=mock

# Microsoft Foundry (only when XRAY_AI_BACKEND=foundry)
# Format: https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=

# Azure OpenAI-compatible endpoint (only when XRAY_AI_BACKEND=openai_compatible)
OPENAI_COMPATIBLE_ENDPOINT=
OPENAI_COMPATIBLE_DEPLOYMENT=
OPENAI_COMPATIBLE_API_VERSION=

# Azure DevOps (Phase 16 - not required for MVP)
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_REPOSITORY=

# Azure AI Search (Phase 18 - not required for MVP)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=

# Local SQL Server read-only metadata source (Phase 15 - not required for MVP)
# The login MUST be read-only. X-Ray asserts this at startup.
SQLSERVER_CONNECTION_STRING=

# Teams incoming webhook (Phase 19 - not required for MVP)
TEAMS_WEBHOOK_URL=

# Analysis tuning
# Depth 6 keeps a frontend -> api -> service -> repository -> table chain in scope.
XRAY_MAX_DEPTH=6
XRAY_CONFIDENCE_THRESHOLD=0.70
XRAY_PARSE_FAILURE_UNKNOWN_RATIO=0.20
